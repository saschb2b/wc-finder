{
  "name": "wc-finder",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "scripts": {
    "data:care": "tsx scripts/update-care-toilets.ts",
    "data:hannover": "tsx scripts/update-hannover.ts",
    "data:municipal": "tsx scripts/update-municipal-toilets.ts",
    "data:nette:review": "tsx scripts/review-nette-toilets.ts",
    "data:partner": "tsx scripts/import-partner-toilets.ts",
    "data:review": "tsx scripts/review-data-imports.ts",
    "build:map": "tsx scripts/build-map-assets.ts",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "quality": "pnpm typecheck && pnpm lint && pnpm test --runInBand && pnpm test:care && pnpm test:data && pnpm test:map",
    "test:data": "tsx --test scripts/lib/overpass.test.ts scripts/lib/merge-osm.test.ts scripts/lib/data-imports.test.ts",
    "test:care": "tsx --test scripts/lib/care-directory.test.ts",
    "test:map": "pnpm build:map && tsx --test src/map/leaflet.test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-haptics": "~57.0.2",
    "expo-location": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.1",
    "jsdom": "^27.4.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true
}
